<Window x:Class="CryptoIndicatorApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CryptoIndicatorApp.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TC-DN-HOFI3 Dashboard"
        Height="760"
        MinHeight="620"
        Width="1100"
        MinWidth="920"
        Background="#F5F6F8"
        Topmost="{Binding IsAlwaysOnTop, Mode=TwoWay}"
        Closed="MainWindow_Closed">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#626A73" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDE2E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PinToggleButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#B8C0CC" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:ContextTileViewModel}">
            <Border Width="74"
                    Height="38"
                    Margin="0,0,6,0"
                    Padding="5,3"
                    Background="{Binding BackgroundBrush}"
                    BorderBrush="#DDE2E7"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               FontSize="10"
                               Foreground="#626A73"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ValueText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#1F2328"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TC-DN-HOFI3"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2328" />
                    <TextBlock Text="Binance Futures"
                               Style="{StaticResource LabelText}"
                               Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="Symbol" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding FilteredSymbols}"
                              SelectedItem="{Binding SelectedSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding SymbolSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              IsEnabled="{Binding IsConfigurationEnabled}"
                              Height="26"
                              Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Mode" Style="{StaticResource LabelText}" />
                    <ComboBox ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsConfigurationEnabled}"
                              Height="26"
                              Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="Refresh"
                            Click="RefreshSymbolsButton_Click"
                            IsEnabled="{Binding IsConfigurationEnabled}"
                            Style="{StaticResource CompactButton}" />
                    <Button Content="Start"
                            Click="StartButton_Click"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource CompactButton}" />
                    <Button Content="Stop"
                            Click="StopButton_Click"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource CompactButton}" />
                    <Button Content="Restart"
                            Click="RestartButton_Click"
                            IsEnabled="{Binding CanRestart}"
                            Style="{StaticResource CompactButton}" />
                </StackPanel>

                <ToggleButton Grid.Column="4"
                              Content="Pin"
                              IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Keep window on top"
                              AutomationProperties.Name="Keep window on top"
                              VerticalAlignment="Bottom"
                              Style="{StaticResource PinToggleButton}" />

                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center"
                            Margin="8,0,12,0">
                    <TextBlock Text="Symbol refresh" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding SymbolRefreshStatus}"
                               Foreground="#1F2328"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="6"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            MinWidth="112">
                    <TextBlock Text="Status" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ConnectionStatus}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F766E"
                               MaxWidth="190"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource MetricTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Z_OFI" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ZOfiText}" Style="{StaticResource MetricText}" MinWidth="70" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TFI" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding TfiText}" Style="{StaticResource MetricText}" MinWidth="66" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource MetricTile}"
                    Background="{Binding SignalBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Signal" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding SignalText}" Style="{StaticResource MetricText}" MinWidth="118" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Book" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding BookHealthText}" Style="{StaticResource MetricText}" MinWidth="72" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricTile}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Latency" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetricText}" MinWidth="62" />
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource MetricTile}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last update" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LastUpdateIdText}" Style="{StaticResource MetricText}" MinWidth="72" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="260">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="60-second chart" FontSize="16" FontWeight="SemiBold" Foreground="#1F2328" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Rectangle Width="18" Height="3" Fill="#0F766E" Margin="0,9,6,0" />
                        <TextBlock Text="Z_OFI" Style="{StaticResource LabelText}" Margin="0,0,18,0" />
                        <Rectangle Width="18" Height="3" Fill="#C2410C" Margin="0,9,6,0" />
                        <TextBlock Text="TFI" Style="{StaticResource LabelText}" />
                    </StackPanel>
                </Grid>
                <Canvas x:Name="ChartCanvas"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="#FBFCFD"
                        ClipToBounds="True"
                        MinHeight="220"
                        SizeChanged="ChartCanvas_SizeChanged">
                    <Line x:Name="ZeroLine" Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="2 4" />
                    <Polyline x:Name="ZOfiLine" Stroke="#0F766E" StrokeThickness="2" />
                    <Polyline x:Name="TfiLine" Stroke="#C2410C" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#DDE2E7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Context"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1F2328"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Observed liquidations"
                               Style="{StaticResource LabelText}"
                               ToolTip="{Binding LiquidationHelpText}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBlock Text="{Binding LiquidationStatus}"
                               Foreground="#1F2328"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Open interest"
                               Style="{StaticResource LabelText}"
                               ToolTip="{Binding OpenInterestHelpText}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBlock Text="{Binding OpenInterestStatus}"
                               Foreground="#1F2328"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Frame"
                               Style="{StaticResource LabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding ContextFrames}"
                              SelectedItem="{Binding SelectedContextFrame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsConfigurationEnabled}"
                              Width="118"
                              Height="24" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Observed liquidations"
                           Style="{StaticResource LabelText}"
                           ToolTip="{Binding LiquidationHelpText}"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ScrollViewer Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding LiquidationTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="Open interest"
                           Style="{StaticResource LabelText}"
                           ToolTip="{Binding OpenInterestHelpText}"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0" />
                <ScrollViewer Grid.Row="2"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding OpenInterestTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Opacity="{Binding ReplayPathOpacity}">
                <TextBlock Text="Replay path" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding ReplayPathDisplay}" Foreground="#1F2328" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Recording path" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding RecordingPath}" Foreground="#1F2328" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
