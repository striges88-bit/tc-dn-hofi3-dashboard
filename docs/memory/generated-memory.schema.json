{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tc-dn-hofi3.local/schemas/generated-memory.schema.json",
  "title": "TC-DN-HOFI3 Generated Memory Index",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "generator",
    "nodes",
    "edges",
    "source_files",
    "tool_availability"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source_file"
      }
    },
    "tool_availability": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/tool"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "title",
        "summary",
        "source_path",
        "source_hash",
        "created_at",
        "updated_at",
        "confidence",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "module",
            "type",
            "formula",
            "rule",
            "decision",
            "experiment",
            "open_question",
            "data_source",
            "config_option"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "proposed",
            "superseded",
            "failed"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "relation",
        "to",
        "source_path",
        "source_hash",
        "confidence"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "depends_on",
            "owns",
            "feeds",
            "calculates",
            "records",
            "replays",
            "guards",
            "supersedes",
            "contradicts",
            "observed_in"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "source_file": {
      "type": "object",
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "available"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
