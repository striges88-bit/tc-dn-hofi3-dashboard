{
  "$schema": "https://opencode.ai/config.json",

  // Project skills: repository workflow and verification skills.
  "skills": ["./skills", "./.cursor/skills"],

  // This repository keeps large local SDK/package caches and runtime data
  // next to the source. Keep the filesystem watcher on source, docs, and tasks.
  // The list repeats the global defaults so the project config is self-contained.
  "watcher": {
    "ignore": [
      "**/bin/**",
      "**/obj/**",
      "**/.vs/**",
      "**/TestResults/**",
      "**/artifacts/**",
      "**/node_modules/**",
      "**/*.user",
      "**/.dotnet/**",
      "**/.dotnet-home/**",
      "**/.nuget/**",
      "**/.tools/**",
      "**/.superpowers/**",
      "**/.engram/**",
      "**/publish/**",
      "**/recordings/**",
      "**/data/**",
      "**/.obsidian/**"
    ]
  }
}
